NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/schoolos
# Max simultaneous DB connections held by this API instance.
DB_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Short-lived access token; the browser silently renews it with a refresh token.
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_DAYS=7

# Set to true only when running behind a reverse proxy / load balancer (Render, Railway, nginx...).
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
# Used to build links in e-mails (password reset, welcome).
FRONTEND_URL=http://localhost:3000
# Login e-mail domain for students when a school has not set its own.
STUDENT_EMAIL_FALLBACK_DOMAIN=students.schoolos.app

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Transactional e-mail (password reset, welcome). Without a key, e-mails are logged, never sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SchoolOS <onboarding@resend.dev>

# File uploads (school logo, student photos, assignment files). Without these, uploads return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
